if(NOT EXISTS "${APE_PLUGIN}")
    message(FATAL_ERROR "Build the existing root project before this experiment: ${APE_PLUGIN}")
endif()
include("${SOURCE_DIR}/helpers/legacy_map.cmake")
foreach(input canonical native-canonical sealed)
    run_legacy_map("${input}")
endforeach()
file(READ "${WORK_DIR}/canonical_ape.json" captured_map)
file(READ "${WORK_DIR}/native-canonical_ape.json" native_map)
file(READ "${WORK_DIR}/sealed_ape.json" sealed_map)
if(NOT captured_map STREQUAL native_map OR NOT sealed_map STREQUAL native_map)
    message(FATAL_ERROR "boundary capture changed the existing whole-function MAP")
endif()

# Independent source expectations: full loop and its external bound/offset.
string(JSON function_count LENGTH "${captured_map}" functions)
string(JSON function_name GET "${captured_map}" functions 0 function)
string(JSON body_count LENGTH "${captured_map}" functions 0 body)
if(NOT function_count EQUAL 1 OR NOT function_name STREQUAL "region_probe" OR NOT body_count EQUAL 3)
    message(FATAL_ERROR "unexpected task or top-level source structure")
endif()
foreach(pair "start;0" "bound;3" "step;1" "var;i")
    list(GET pair 0 key)
    list(GET pair 1 expected_value)
    string(JSON actual GET "${captured_map}" functions 0 body 1 "${key}")
    if(NOT actual STREQUAL expected_value)
        message(FATAL_ERROR "incorrect loop ${key}: ${actual}")
    endif()
endforeach()
string(JSON inner_count LENGTH "${captured_map}" functions 0 body 1 body)
if(NOT inner_count EQUAL 2)
    message(FATAL_ERROR "unexpected loop accesses")
endif()
foreach(index 0 1)
    string(JSON object GET "${captured_map}" functions 0 body 1 body ${index} object)
    string(JSON offset GET "${captured_map}" functions 0 body 1 body ${index} indices 0)
    string(JSON operation GET "${captured_map}" functions 0 body 1 body ${index} op)
    if(NOT object STREQUAL "global::inside" OR NOT offset STREQUAL "i+1")
        message(FATAL_ERROR "external offset or global binding changed")
    endif()
    if((index EQUAL 0 AND NOT operation STREQUAL "load") OR
       (index EQUAL 1 AND NOT operation STREQUAL "store"))
        message(FATAL_ERROR "source operation order changed")
    endif()
endforeach()
