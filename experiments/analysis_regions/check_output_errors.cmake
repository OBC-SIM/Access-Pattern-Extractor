find_program(REGION_SH sh REQUIRED)
foreach(probe compile capture)
    set(failed_output "${WORK_DIR}/write-error-${probe}.ll")
    if(probe STREQUAL "compile")
        set(probe_command "${COMPILER}" "${boundary}" "${failed_output}")
        set(expected_diagnostic "cannot write IR")
    else()
        set(probe_command "${PROBE}" capture "${WORK_DIR}/marked.ll" "${failed_output}")
        set(expected_diagnostic "cannot write captured IR")
    endif()
    execute_process(COMMAND "${REGION_SH}" "${SOURCE_DIR}/helpers/limit_output.sh" ${probe_command}
        RESULT_VARIABLE write_status OUTPUT_VARIABLE write_output ERROR_VARIABLE write_diagnostic)
    if(NOT write_status STREQUAL "1" OR NOT write_diagnostic MATCHES "${expected_diagnostic}")
        message(FATAL_ERROR "${probe}: expected normal write-error exit 1, got ${write_status}\n${write_output}\n${write_diagnostic}")
    endif()
endforeach()
