cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${WORK_DIR}")
find_program(OPT opt-14 REQUIRED)

function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${ARGV}\n${output}\n${error}")
    endif()
endfunction()

function(expect_snapshot input expected output_name)
    execute_process(COMMAND "${PROBE}" inspect "${WORK_DIR}/${input}"
        RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error)
    file(WRITE "${WORK_DIR}/${output_name}" "${actual}")
    if(NOT status EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "${input}: snapshot mismatch\n${actual}\n${error}")
    endif()
endfunction()

set(canonical "function(mem2reg),loop-simplify")
set(compile_o0 "${CLANG}" -O0 -Xclang -disable-O0-optnone -g -emit-llvm -S)
set(boundary "${SOURCE_DIR}/fixtures/boundary.c")
run(${compile_o0} "${boundary}" -o native.ll)
run(${compile_o0} "-fplugin=${PLUGIN}" "${boundary}" -o marked.ll)
file(READ "${WORK_DIR}/native.ll" native)
file(READ "${WORK_DIR}/marked.ll" marked)
if(native MATCHES "llvm.annotation" OR NOT marked MATCHES "llvm.annotation")
    message(FATAL_ERROR "pragma-to-IR premise did not hold")
endif()
if(NOT native MATCHES "ape.analyze" OR NOT marked MATCHES "ape.analyze")
    message(FATAL_ERROR "function annotation was lost")
endif()
run("${PROBE}" capture "${WORK_DIR}/marked.ll" "${WORK_DIR}/captured.ll")
run("${OPT}" "-passes=${canonical}" -S captured.ll -o canonical.ll)
run("${OPT}" "-passes=${canonical}" -S native.ll -o native-canonical.ll)
set(expected "function region_probe\nstore before outside\nload inside region\nstore inside region\nstore after outside\n")
expect_snapshot(canonical.ll "${expected}" canonical.txt)
run("${COMPILER}" "${boundary}" "${WORK_DIR}/sealed.ll")
expect_snapshot(sealed.ll "${expected}" sealed.txt)
include("${SOURCE_DIR}/check_pipeline_guard.cmake")
string(REPLACE "inside region" "inside outside" native_expected "${expected}")
expect_snapshot(native-canonical.ll "${native_expected}" native-canonical.txt)
file(READ "${WORK_DIR}/canonical.ll" canonical_ir)
if(canonical_ir MATCHES "call i32 @llvm.annotation")
    message(FATAL_ERROR "marker call reached normalized analysis IR")
endif()

# Prove membership does not use debug line ranges.
run("${OPT}" -strip-debug -S marked.ll -o no-debug.ll)
run("${PROBE}" capture "${WORK_DIR}/no-debug.ll" "${WORK_DIR}/no-debug-captured.ll")
run("${OPT}" "-passes=${canonical}" -S no-debug-captured.ll -o no-debug-canonical.ll)
expect_snapshot(no-debug-canonical.ll "${expected}" no-debug.txt)

# Empty selection retains identity after annotation calls are erased.
run(${compile_o0} "-fplugin=${PLUGIN}" "${SOURCE_DIR}/fixtures/empty.c" -o empty.ll)
run("${PROBE}" capture "${WORK_DIR}/empty.ll" "${WORK_DIR}/empty-captured.ll")
expect_snapshot(empty-captured.ll
    "function empty_probe\nstore before outside\nstore after outside\n" empty.txt)
file(READ "${WORK_DIR}/empty-captured.ll" empty_ir)
if(NOT empty_ir MATCHES "\"yarda.region\"=\"APE_ANALYZE\"")
    message(FATAL_ERROR "empty region identity was lost")
endif()

include("${SOURCE_DIR}/check_normalization.cmake")
include("${SOURCE_DIR}/check_optimization.cmake")
include("${SOURCE_DIR}/check_map.cmake")
include("${SOURCE_DIR}/check_global_values.cmake")
if(CMAKE_HOST_UNIX)
    include("${SOURCE_DIR}/check_output_errors.cmake")
endif()
message(STATUS "R1 boundary observations passed: ${WORK_DIR}")
