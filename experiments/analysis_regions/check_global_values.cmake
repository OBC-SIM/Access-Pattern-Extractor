set(global_fixture "${SOURCE_DIR}/fixtures/global_values.c")
run(${compile_o0} "${global_fixture}" -o global-values-native.ll)
run(${compile_o0} "-fplugin=${PLUGIN}" "${global_fixture}" -o global-values-marked.ll)
run("${PROBE}" capture "${WORK_DIR}/global-values-marked.ll" "${WORK_DIR}/global-values-captured.ll")
run("${OPT}" "-passes=${canonical}" -S global-values-captured.ll -o global-values-canonical.ll)
run("${OPT}" "-passes=${canonical}" -S global-values-native.ll -o global-values-native-canonical.ll)
run("${COMPILER}" "${global_fixture}" "${WORK_DIR}/global-values-sealed.ll")
set(global_expected "function global_values_probe\nload external_value outside\nstore before outside\nload external_value region\nload inside region\nstore inside region\nstore after outside\n")
foreach(input global-values-canonical global-values-sealed)
    expect_snapshot("${input}.ll" "${global_expected}" "${input}.txt")
endforeach()
string(REPLACE " region" " outside" global_native_expected "${global_expected}")
expect_snapshot(global-values-native-canonical.ll "${global_native_expected}" global-values-native.txt)

foreach(input global-values-native-canonical global-values-canonical global-values-sealed)
    run_legacy_lat("${input}")
endforeach()
file(READ "${WORK_DIR}/global-values-native-canonical_ape.json" global_native_lat)
foreach(input global-values-canonical global-values-sealed)
    file(READ "${WORK_DIR}/${input}_ape.json" global_lat)
    if(NOT global_lat STREQUAL global_native_lat)
        message(FATAL_ERROR "${input}: outside dependency/global load changed whole-function LAT")
    endif()
endforeach()

# Independent source expectations: one outside read, one selected read per iteration.
string(JSON global_body_count LENGTH "${global_native_lat}" functions 0 body)
string(JSON global_inner_count LENGTH "${global_native_lat}" functions 0 body 2 body)
if(NOT global_body_count EQUAL 4 OR NOT global_inner_count EQUAL 3)
    message(FATAL_ERROR "unexpected global-value access structure")
endif()
foreach(pair "start;0" "bound;3" "step;1" "var;i")
    list(GET pair 0 global_key)
    list(GET pair 1 global_expected_value)
    string(JSON global_actual GET "${global_native_lat}" functions 0 body 2 "${global_key}")
    if(NOT global_actual STREQUAL global_expected_value)
        message(FATAL_ERROR "incorrect global-constant loop ${global_key}: ${global_actual}")
    endif()
endforeach()
foreach(index 0 1 2)
    string(JSON global_object GET "${global_native_lat}" functions 0 body 2 body ${index} object)
    string(JSON global_operation GET "${global_native_lat}" functions 0 body 2 body ${index} op)
    if(index EQUAL 0)
        if(NOT global_object STREQUAL "global::external_value" OR NOT global_operation STREQUAL "load")
            message(FATAL_ERROR "selected global sample must precede the inside update")
        endif()
    else()
        string(JSON global_index GET "${global_native_lat}" functions 0 body 2 body ${index} indices 0)
        if(NOT global_object STREQUAL "global::inside" OR NOT global_index STREQUAL "i+1")
            message(FATAL_ERROR "global constant offset was not resolved")
        endif()
        if((index EQUAL 1 AND NOT global_operation STREQUAL "load") OR
           (index EQUAL 2 AND NOT global_operation STREQUAL "store"))
            message(FATAL_ERROR "global-value fixture changed load/store order")
        endif()
    endif()
endforeach()

# Boundary-only observation: R2 must reject this unresolved bound before LAT output.
run("${COMPILER}" "${SOURCE_DIR}/fixtures/dynamic_bound.c" "${WORK_DIR}/dynamic-bound.ll")
expect_snapshot(dynamic-bound.ll
    "function dynamic_bound_probe\nload bound region\nload inside region\nstore inside region\n"
    dynamic-bound.txt)
